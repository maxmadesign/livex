# PLUSH PORTAL — server-side configuration.
# Copy this file to `.env` (never commit `.env`). Only the API server reads it;
# nothing in here is ever sent to the browser, written to logs or exported.

# ---------------------------------------------------------------- OpenAI ----
# Optional. Without a key the game is fully playable: Momo uses her local
# lines and the built-in "babble" voice, and the UI says "Local lines".
OPENAI_API_KEY=

# Text model for Momo's lines (Responses API + Structured Outputs).
# Default gpt-6-luna: listed in the OpenAI docs (2026-11) for cost-sensitive,
# high-volume work, supports structured outputs and reasoning effort "none"
# (lowest latency). Any Responses-capable text model works; the server only
# sends the sampling / reasoning parameters that model family accepts.
#OPENAI_TEXT_MODEL=gpt-6-luna

# Voice. There are two different OpenAI interfaces and the model must belong
# to the one you choose (the server refuses mismatches instead of trying):
#   realtime (default)  Realtime API, text in -> audio out, no microphone.
#                       Models: gpt-realtime-2.1-mini (default), gpt-realtime-2.1, ...
#   speech              /v1/audio/speech with a TTS model: gpt-4o-mini-tts, tts-1, tts-1-hd.
#                       OpenAI has announced the shutdown of these models for
#                       2027-01-06 and recommends gpt-realtime-2.1-mini instead.
#OPENAI_SPEECH_API=realtime
#OPENAI_SPEECH_MODEL=gpt-realtime-2.1-mini
# Built-in voices for both interfaces: alloy ash ballad coral echo sage shimmer
# verse marin cedar (the Speech API additionally has fable onyx nova).
#OPENAI_VOICE=marin
# Optional reasoning effort for reasoning-capable Realtime models
# (minimal | low | medium | high | xhigh). Unset = the field is not sent.
#OPENAI_REALTIME_REASONING_EFFORT=
# Optional API gateway. Must be https (http is accepted for localhost only).
#OPENAI_BASE_URL=

# ---------------------------------------------------------------- Server ----
# If you change the port, export PLUSH_API_PORT in the shell as well so the
# Vite dev server proxies /api to the same port.
#PLUSH_API_PORT=8787
# 127.0.0.1 = this machine only. Use 0.0.0.0 to serve other devices on the LAN.
#PLUSH_API_HOST=127.0.0.1

# ------------------------------------------------ Public deployments --------
# When set, /api/ai/test and per-request model overrides need
# "Authorization: Bearer <token>". Players never need it to play.
#PLUSH_ADMIN_TOKEN=
# false: ignore system prompt / personality / model sent by browsers and
# always use the server's own prompt and models.
#PLUSH_ALLOW_CLIENT_PROMPT=true
# Requests per minute and client IP on the paid routes (line, speech, test, models).
#PLUSH_RATE_LIMIT_PER_MIN=60
# Comma separated origins that may call the API cross-origin. The game's own
# origin (dev proxy or `npm start`) always works without an entry.
#PLUSH_ALLOWED_ORIGINS=
# true only behind a reverse proxy that sets X-Forwarded-For.
#PLUSH_TRUST_PROXY=false
# Upper bounds for one upstream call (the browser's own time limit is shorter).
#PLUSH_TEXT_TIMEOUT_MS=6000
#PLUSH_SPEECH_TIMEOUT_MS=12000
# silent | error | info | debug. Logs never contain keys or full prompts.
#PLUSH_LOG_LEVEL=info
