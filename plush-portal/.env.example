# PLUSH PORTAL — server-side configuration.
# Copy this file to `.env` (never commit `.env`). Only the API server reads it;
# nothing in here is ever sent to the browser, written to logs or exported.

# ---------------------------------------------------------------- OpenAI ----
# Optional. Without a key the game is fully playable: Momo uses her local
# lines and the built-in "babble" voice, and the UI says "Local lines".
# This is the default key. It can be replaced at run time in Settings → AI Guide
# → "OpenAI API key" (stored server-side in .data/secrets.json, mode 0600, and
# used instead of this one until "Restore default" is pressed).
OPENAI_API_KEY=

# Text model for Momo's lines (Responses API + Structured Outputs).
# Default gpt-6-luna: listed in the OpenAI docs (2026-11) for cost-sensitive,
# high-volume work, supports structured outputs and reasoning effort "none"
# (lowest latency). Any Responses-capable text model works; the server only
# sends the sampling / reasoning parameters that model family accepts.
#OPENAI_TEXT_MODEL=gpt-6-luna

# Voice. There are two different OpenAI interfaces and the model must belong
# to the one you choose (the server refuses mismatches instead of trying):
#   realtime (default)  Realtime API, text in -> audio out, no microphone.
#                       Models: gpt-realtime-2.1-mini (default), gpt-realtime-2.1, ...
#   speech              /v1/audio/speech with a TTS model: gpt-4o-mini-tts, tts-1, tts-1-hd.
#                       OpenAI has announced the shutdown of these models for
#                       2027-01-06 and recommends gpt-realtime-2.1-mini instead.
#OPENAI_SPEECH_API=realtime
#OPENAI_SPEECH_MODEL=gpt-realtime-2.1-mini
# Built-in voices for both interfaces: alloy ash ballad coral echo sage shimmer
# verse marin cedar (the Speech API additionally has fable onyx nova).
#OPENAI_VOICE=marin
# Optional reasoning effort for reasoning-capable Realtime models
# (minimal | low | medium | high | xhigh). Unset = the field is not sent.
#OPENAI_REALTIME_REASONING_EFFORT=
# Optional API gateway. Must be https (http is accepted for localhost only).
#OPENAI_BASE_URL=

# ------------------------------------------------- Replacing the key -------
# Who may replace / test / restore the key from Settings:
#   local (default)  requests made on the server machine itself (localhost), or
#                    anyone sending the admin token (PLUSH_ADMIN_TOKEN)
#   token            only requests with the admin token
#   off              nobody; only OPENAI_API_KEY counts and a stored key is ignored
#PLUSH_KEY_MANAGEMENT=local
# Check a new key against OpenAI (GET /v1/models) before storing it.
#PLUSH_KEY_CHECK=true
#PLUSH_KEY_CHECK_TIMEOUT_MS=6000
# Folder for server-side state (replaced key, generated HTTPS certificate, prize codes). Git-ignored.
#PLUSH_DATA_DIR=.data

# ------------------------------------------------------- Network / proxy ----
# Outbound calls to OpenAI follow the usual proxy variables; no Node flag is
# needed (fetch and the Realtime WebSocket both use them):
#HTTPS_PROXY=
#HTTP_PROXY=
#NO_PROXY=
# Extra CA certificates (PEM file or bundle) for a TLS-inspecting proxy. Both
# are read when the server starts, also when they are only set in this file.
#NODE_EXTRA_CA_CERTS=
#SSL_CERT_FILE=

# ---------------------------------------------------------------- Server ----
# Port of the API/proxy server. The Vite dev server reads the same value from
# this file (or the shell) and proxies /api to it.
#PLUSH_API_PORT=8787
# 127.0.0.1 = this machine only. Use 0.0.0.0 to serve other devices on the LAN.
#PLUSH_API_HOST=127.0.0.1

# ---------------------------------------------- HTTPS for phones (opt-in) ----
# Browsers only allow the camera on HTTPS pages (or on localhost). With
# PLUSH_HTTPS=1 (or `npm run start:https`) `npm start` also listens with HTTPS.
# Without PLUSH_TLS_CERT / PLUSH_TLS_KEY a self-signed certificate for this
# machine's names and LAN addresses is generated on first start (.data/tls/).
#PLUSH_HTTPS=1
#PLUSH_HTTPS_PORT=8443
# Interfaces the HTTPS listener binds to (default: all, so phones can reach it).
#PLUSH_HTTPS_HOST=0.0.0.0
# Your own certificate and key (PEM), both or neither.
#PLUSH_TLS_CERT=
#PLUSH_TLS_KEY=
# Dev server: `npm run dev:https` (or PLUSH_DEV_HTTPS=1 with `npm run dev`)
# serves Vite over HTTPS on 0.0.0.0:5173 with the same certificate.
#PLUSH_DEV_HTTPS=1
# Interface for the Vite dev server (default 127.0.0.1, or 0.0.0.0 in HTTPS mode).
#PLUSH_DEV_HOST=

# ------------------------------------------------- Prize claims (QR) --------
# After a real win the kiosk shows a QR code; the visitor's phone opens a claim
# page to collect the plush at the booth or take a swag discount, and staff mark
# it redeemed at /staff/rewards. Codes are kept in <PLUSH_DATA_DIR>/rewards.json
# (codes and prize facts only, no personal data). Details: docs/REWARDS.md.
# off: no new codes and no claim listener (issued codes stay redeemable).
#PLUSH_REWARDS=on
# A second listener that serves ONLY the claim pages (/c/*) to phones on the
# booth network, on all interfaces. 0 = any free port.
#PLUSH_CLAIM_PORT=8788
# off: no claim listener; QR links then point at this machine only.
#PLUSH_CLAIM_LAN=on
# Event Wi-Fi usually isolates phones from each other: put the claim listener
# behind an https reverse proxy / tunnel and set its public base URL here
# (the QR codes then use it), e.g. https://claim.example.com
#PLUSH_CLAIM_PUBLIC_URL=
# Hours a code stays valid (1-720).
#PLUSH_REWARD_TTL_HOURS=24
# Brand kit of the claim and staff pages: gtc or neutral (no real event marks).
# Keep it equal to the VITE_BRAND the game was built with.
#PLUSH_BRAND=gtc

# ------------------------------------------------ Public deployments --------
# When set, /api/ai/test and per-request model overrides need
# "Authorization: Bearer <token>". Players never need it to play. It also lets
# a browser that is not on the server machine replace the key (see above),
# issue prize codes, and open the staff page once with /staff/rewards?token=…
#PLUSH_ADMIN_TOKEN=
# false: ignore system prompt / personality / model sent by browsers and
# always use the server's own prompt and models.
#PLUSH_ALLOW_CLIENT_PROMPT=true
# Requests per minute and client IP on the paid routes (line, speech, test, models).
#PLUSH_RATE_LIMIT_PER_MIN=60
# Comma separated origins that may call the API cross-origin. The game's own
# origin (dev proxy or `npm start`) always works without an entry.
#PLUSH_ALLOWED_ORIGINS=
# true only behind a reverse proxy that sets X-Forwarded-For.
#PLUSH_TRUST_PROXY=false
# Upper bounds for one upstream call (the browser's own time limit is shorter).
#PLUSH_TEXT_TIMEOUT_MS=6000
#PLUSH_SPEECH_TIMEOUT_MS=12000
# silent | error | info | debug. Logs never contain keys or full prompts.
#PLUSH_LOG_LEVEL=info
