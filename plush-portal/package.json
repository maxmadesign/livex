{
  "name": "plush-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PLUSH PORTAL — a browser 3D claw machine with head-coupled window perspective",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts --serve-dist",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "assets:plush": "tsx tools/plush/bake.ts",
    "assets:audio": "tsx tools/audio/bake.ts",
    "assets:tracking": "node tools/fetch-tracking-assets.mjs",
    "assets": "npm run assets:plush && npm run assets:audio && npm run assets:tracking"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@hono/node-server": "2.1.11",
    "@mediapipe/tasks-vision": "1.2.3",
    "hono": "4.13.21",
    "openai": "7.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "ws": "8.23.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "dotenv": "18.0.10",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
